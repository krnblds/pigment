# Godot
.godot/
# generated by tools/godot/export_town.py + pack_textures.py (regenerate, see docs/agents/godot/NOTES.md)
assets/town/
# textures Godot extracts from car.glb on import
assets/car/*.png
assets/car/*.png.import
# textures Godot extracts from the traffic / fleet glbs on import
assets/traffic/**/*.png
assets/traffic/**/*.png.import
# fleet + props copied in by tools/godot/sync_vehicles.py (source of truth: assets/vehicles, assets/props)
assets/vehicles/
assets/props/
# the fleet's glTF variant extension, copied in by tools/godot/sync_vehicles.py
addons/fleet_variants/vehicle_variants.gd
addons/fleet_variants/vehicle_variants.gd.uid
# open world export (tools/world/world_driver.py --stages ...,export)
assets/world/
# hot-swap event queue (tools/city live link, game/scripts/live_link.gd)
assets/.live/
# tree kit, copied in by tools/trees/sync_godot.py (source of truth: assets/trees)
assets/trees/
