; Engine configuration file.
; Godot 4.7, Forward+.  Town assets in assets/town/ are generated (see docs/agents/godot/NOTES.md).

config_version=5

[application]

config/name="Neon Hill (Pigment town)"
config/description="Drivable night-city prototype of the Pigment / Blender cyberpunk hill town."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/vsync/vsync_mode=1

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"detect_3d/compress_to": 0
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/physics_interpolation=true
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96
textures/vram_compression/import_s3tc_bptc=true
mesh_lod/lod_change/threshold_pixels=2.0
