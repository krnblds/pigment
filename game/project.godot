; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neon Hill (Pigment town)"
config/description="Drivable night-city prototype of the Pigment / Blender cyberpunk hill town."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

LiveLink="*res://scripts/live_link.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/use_debanding=true
environment/volumetric_fog/volume_size=96
anti_aliasing/quality/use_taa=true
mesh_lod/lod_change/threshold_pixels=2.0
textures/default_filters/anisotropic_filtering_level=4

[editor_plugins]

enabled=PackedStringArray("res://addons/fleet_variants/plugin.cfg")
