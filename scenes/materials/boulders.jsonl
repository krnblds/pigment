{"tool": "new_project", "args": {"mesh": "assets/boulders.glb", "resolution": 2048, "material": "Granite"}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Granite", "image": {"tile_set": "assets/tiles/granite_weathered", "projection": "triplanar", "tile_size": 0.4, "blend_sharpness": 6, "normal_strength": 1.0}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Tone", "values": {"base_color": [0.3, 0.29, 0.27], "roughness": 0.85}, "opacity": 0.3, "mask": {"generator": "grunge", "amount": 0.5, "scale": 1.5}, "channels": {"height": false, "metallic": false}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Cracks", "anchor": "cracks", "values": {"base_color": [0.16, 0.15, 0.13], "roughness": 0.9, "height": -0.35}, "opacity": 0.6, "mask": {"generator": "rock", "variant": "cracks", "scale": 3}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Grime in cracks", "values": {"base_color": [0.14, 0.11, 0.08], "roughness": 0.9}, "opacity": 0.6, "mask": {"generator": "dirt", "amount": 0.45, "input": {"anchor": "cracks", "radius": 10, "strength": 6}}, "channels": {"height": false}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Lichen", "image": {"tile_set": "assets/tiles/granite_lichen", "projection": "triplanar", "tile_size": 0.4, "blend_sharpness": 6, "normal_strength": 1.0}, "mask": {"generator": "moss", "amount": 0.6, "softness": 0.3, "effects": [{"generator": "grunge", "amount": 0.75, "scale": 2.5, "op": "multiply"}]}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Moss", "material": "Moss green", "mask": {"generator": "moss", "amount": 0.3, "effects": [{"generator": "grunge", "amount": 0.7, "scale": 10, "op": "multiply"}]}}}
{"tool": "add_layer", "args": {"kind": "fill", "name": "Soil at the foot", "values": {"base_color": [0.17, 0.13, 0.09], "roughness": 0.92}, "opacity": 0.4, "mask": {"generator": "dirt", "amount": 0.2, "ao_influence": 2.0, "curvature_weight": 0.2}, "channels": {"height": false}}}
{"tool": "send_to_blender", "args": {"dir": "scenes/materials/textures/boulders", "name": "boulders", "project": "scenes/materials/projects/boulders.pigment"}}
{"tool": "render", "args": {"path": "scenes/materials/renders/boulders.png", "lighting": "studio", "width": 640, "height": 640}}
