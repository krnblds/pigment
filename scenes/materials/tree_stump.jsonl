{"tool": "new_project", "args": {"mesh": "assets/tree_stump.glb", "texture_sets": [{"name": "Bark", "materials": ["Bark"], "resolution": 2048}, {"name": "EndGrain", "materials": ["EndGrain"], "resolution": 2048}]}}
{"tool": "add_layer", "args": {"texture_set": "Bark", "kind": "fill", "name": "Bark", "image": {"tile_set": "assets/tiles/bark_fissured", "projection": "triplanar", "tile_size": 0.6, "blend_sharpness": 6, "roughness_range": [0.8, 1.0]}}}
