{"tool": "new_project", "args": {"mesh": "assets/town/street_segment.glb", "resolution": 4096, "material": "Asphalt"}}
{"tool": "bake", "args": {"curvature_radius": 0.004, "ao_distance": 0.1}}
{"tool": "add_layer", "args": {"name": "Asphalt (tiles)", "image": {"tile_set": "assets/tiles/asphalt_cracks", "projection": "triplanar", "tile_size": 2.0, "height_scale": 0.15}, "mask": {"parts": [0]}}}
{"tool": "add_layer", "args": {"name": "Puddles", "mask": {"parts": [0], "generator": "grunge", "amount": 0.45, "scale": 0.3, "softness": 0.04}, "values": {"base_color": [0.07, 0.07, 0.075], "roughness": 0.015, "height": -0.05}}}
{"tool": "add_layer", "args": {"name": "Curbs (tiles)", "image": {"tile_set": "assets/tiles/concrete_slab", "projection": "triplanar", "tile_size": 1.0, "blend_sharpness": 8, "height_scale": 0.1}, "mask": {"parts": [1, 3]}}}
{"tool": "add_layer", "args": {"name": "Paving setts (tiles)", "image": {"tile_set": "assets/tiles/paving_setts", "projection": "triplanar", "tile_size": 1.0, "height_scale": 0.2}, "mask": {"parts": [2, 4]}}}
{"tool": "add_layer", "args": {"name": "Paving grime", "material": "Grime", "mask": {"parts": [2, 4, 1, 3], "generator": "grunge", "amount": 0.4, "scale": 1.2, "softness": 0.25}, "opacity": 0.6}}
{"tool": "add_layer", "args": {"name": "Iron covers", "material": "Dark iron", "mask": {"parts": [5, 6, 7, 8, 9]}}}
{"tool": "add_layer", "args": {"name": "Cover rust", "material": "Rust", "mask": {"parts": [5, 6, 7, 8, 9], "generator": "spots", "amount": 0.35, "scale": 8.0}}}
{"tool": "add_layer", "args": {"name": "Wet grime", "material": "Grime", "mask": {"parts": [0], "generator": "grunge", "amount": 0.35, "scale": 1.5, "softness": 0.3}, "opacity": 0.5}}
{"tool": "render", "args": {"yaw": 25, "pitch": 12, "width": 640, "height": 800, "exposure": -0.3, "path": "docs/agents/image-fills/street_segment_tiles_a.png"}}
{"tool": "render", "args": {"yaw": -50, "pitch": 18, "width": 640, "height": 800, "exposure": -0.3, "path": "docs/agents/image-fills/street_segment_tiles_b.png"}}
{"tool": "export_textures", "args": {"dir": "scenes/town/textures/street_segment_tiles", "preset": "separate", "name": "street_segment"}}
{"tool": "save_project", "args": {"path": "scenes/town/image_fill_demo/street_segment_tiles.pigment"}}
